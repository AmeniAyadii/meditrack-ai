# meditrack-ai/.env.production

# ============================================
# CONFIGURATION API
# ============================================
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=False
API_VERSION=1.0.0
API_TITLE=MediTrack AI - Analyse Tension Artérielle
API_DESCRIPTION=API d'intelligence artificielle pour l'analyse des tensions artérielles

# ============================================
# SÉCURITÉ
# ============================================
# 🔥 IMPORTANT : Changez ces clés pour la production !
API_KEY=votre-cle-api-secrete-tres-longue-et-complexe
JWT_SECRET=votre-jwt-secret-tres-longue-et-complexe
ALLOWED_ORIGINS=https://votre-domaine.com,https://www.votre-domaine.com

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=WARNING
LOG_FILE=logs/app.log

# ============================================
# PERFORMANCE
# ============================================
CACHE_TTL=3600
MAX_MEASURES_FOR_ANALYSIS=100

# ============================================
# BASE DE DONNÉES (Optionnel)
# ============================================
# DATABASE_URL=postgresql://user:password@db:5432/meditrack

# ============================================
# REDIS (Optionnel)
# ============================================
# REDIS_URL=redis://redis:6379